# Managed by chezmoi.
# Plain zsh config (no oh-my-zsh).

setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE

ZSH_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"

# Modular zsh config lives in ~/.config/zsh/{env,aliases,functions}.zsh (loads in order)
for zsh_file in env aliases functions; do
  if [ -r "${ZSH_CONFIG_DIR}/${zsh_file}.zsh" ]; then
    source "${ZSH_CONFIG_DIR}/${zsh_file}.zsh"
  fi
done
unset zsh_file

# Special config for each host eg. ~/.config/zsh/hosts/DaStudio.zsh (if it exists)
HOST_SHORT="$(hostname -s 2>/dev/null || hostname)"
HOST_FILE="${ZSH_CONFIG_DIR}/hosts/${HOST_SHORT}.zsh"
if [ -r "$HOST_FILE" ]; then
  source "$HOST_FILE"
fi
unset HOST_SHORT HOST_FILE

# Completion
autoload -Uz compinit
COMPDUMP_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
mkdir -p "$COMPDUMP_DIR" 2>/dev/null || true
compinit -d "${COMPDUMP_DIR}/zcompdump"
unset COMPDUMP_DIR

# History substring search with ↑/↓ (matches anywhere in the command line)
if [ -r /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]; then
  source /opt/homebrew/share/zsh-history-substring-search/zsh-history-substring-search.zsh
elif [ -r /usr/local/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]; then
  source /usr/local/share/zsh-history-substring-search/zsh-history-substring-search.zsh
fi

if typeset -f history-substring-search-up >/dev/null 2>&1; then
  for keymap in emacs viins; do
    bindkey -M "$keymap" '^[[A' history-substring-search-up
    bindkey -M "$keymap" '^[[B' history-substring-search-down
    bindkey -M "$keymap" '^[OA' history-substring-search-up
    bindkey -M "$keymap" '^[OB' history-substring-search-down
  done
  unset keymap
fi

# Prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Directory jumping (keeps the `z` command)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi
